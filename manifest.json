{
  "manifest_version": 3,
  "name": "ClassCharts Improver",
  "description": "Adds features to ClassCharts.",
  "version": "5.7.9",
    "background": {
    "service_worker": "service-worker.js"
  },
  "action": {},
  "permissions": ["storage", "identity"],
  "content_scripts": [
    {
      "matches": [
        "https://www.classcharts.com/mobile/student*",
        "https://www.classcharts.com/student/login",
        "https://www.classcharts.com/student/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://www.classcharts.com/*", "https://izcixahquohigrzghyqv.supabase.co/*", "https://jamesauth.pages.dev/*"],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/customlogo.png",
        "assets/threadtutorial.png",
        "assets/icons/icon-16.png",
        "assets/icons/icon-48.png",
        "assets/icons/icon-128.png",
        "assets/feather/*",
        "assets/*.html",
        "assets/*.js"
      ],
      "matches": ["https://www.classcharts.com/*"]
    },
    {
      "resources": [
        "https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.5.0/dist-cdn/styles/themes/default.min.css",
        "https://cdn.jsdelivr.net/npm/@awesome.me/webawesome@3.5.0/dist/webawesome.loader.min.js"
      ],
      "matches": ["https://www.classcharts.com/*"]
    }
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
